{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "NIXPACKS",
    "watchPatterns": [
      "apps/api/**",
      "packages/db/**",
      "packages/shared/**",
      "package.json",
      "pnpm-lock.yaml"
    ]
  },
  "deploy": {
    "startCommand": "node apps/api/dist/cron.js",
    "cronSchedule": "0 3 * * *",
    "restartPolicyType": "NEVER",
    "numReplicas": 1
  }
}