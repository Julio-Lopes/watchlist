# Porta injetada pelo Railway em producao. Local usa esta.
PORT=3333
NODE_ENV=development
LOG_LEVEL=info

# Neon. Pooled connection string, com sslmode=require.
DATABASE_URL=postgresql://user:password@ep-exemplo.sa-east-1.aws.neon.tech/watchlist?sslmode=require

# Origem do front. Com proxy por rewrite o browser nunca chama a API
# direto, mas o valor e usado em links de e-mail e no callback do OAuth.
WEB_ORIGIN=http://localhost:3000